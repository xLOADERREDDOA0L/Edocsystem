{
  "name": "@workspace/e2e-tests",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "LD_LIBRARY_PATH=$(ls -d /nix/store/*-mesa-libgbm-*/lib 2>/dev/null | head -1):$LD_LIBRARY_PATH playwright test",
    "test:ui": "LD_LIBRARY_PATH=$(ls -d /nix/store/*-mesa-libgbm-*/lib 2>/dev/null | head -1):$LD_LIBRARY_PATH playwright test --ui",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.3.3"
  }
}
