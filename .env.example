# Copy this file to `artifacts/api-server/.env` (and `lib/db/.env` for drizzle commands)
# then fill in your local values.

# --- Required ---
# Local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edocs

# Secret used to sign JWT auth tokens (use any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# --- Optional ---
# API server port (defaults to 8080; the frontend proxy expects 8080)
# PORT=8080

# Log level: debug | info | warn | error
# LOG_LEVEL=info
